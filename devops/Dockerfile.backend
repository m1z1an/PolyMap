FROM python:3.12-slim
WORKDIR /app
COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt
COPY backend /app/backend
COPY frontend/public/maps /app/frontend/public/maps
CMD ["sh", "-ec", "alembic -c backend/alembic.ini upgrade head && python -m backend.main frontend/public/maps/campus.json && exec uvicorn backend.main:app --host 0.0.0.0 --port 8000"]
